# Nevermined (required). The environment (sandbox/live) is derived from the key prefix.
NVM_API_KEY=sandbox:your-api-key

# Plan IDs — created by `yarn register-plans` (see scripts/register-plans.ts)
PLAN_ID_CREDITS=
PLAN_ID_TIME=
PLAN_ID_PAYG=

# For `yarn register-plans` only: the builder wallet that receives payment.
# REQUIRED for crypto-priced (payable) plans — without it the plans register as FREE.
NVM_RECEIVER=
# Optional: on-chain price per plan purchase, in the token's smallest unit (default 0).
PLAN_PRICE_WEI=0

# Server
PORT=3000
