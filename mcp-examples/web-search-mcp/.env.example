############################################
# Server
############################################
NVM_API_KEY=your_nevermined_api_key   # the key prefix (e.g. sandbox:) selects the environment
NVM_PLAN_ID=your_nevermined_plan_id
# NVM_AGENT_ID=your_nevermined_agent_id  # optional — informational only (plan-centric)

# Server configuration
PORT=3010

# External URL (required for HTTPS/remote deployments; advertised in OAuth metadata)
# Leave unset for local dev (defaults to http://localhost:PORT)
# BASE_URL=https://your-external-domain.com
