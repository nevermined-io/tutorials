# ---------------------------------------------------------------------------
# Merchant backend — SERVER-SIDE ONLY. None of these are NEXT_PUBLIC_*, so
# nothing here ships to the browser bundle.
# ---------------------------------------------------------------------------

# The ORGANIZATION's Nevermined API key. This is a SECRET — it authorizes
# creating orders (charging cards) on the org's behalf. It lives only in the
# merchant backend (/api/orders) and must NEVER be exposed to the browser.
# Copy this file to .env.local (gitignored) and paste your org key here.
NVM_ORDER_API_KEY=

# The Nevermined API the merchant backend calls to create orders.
# Orders (epic #3238) is deployed in sandbox; use it directly. For a local stack
# (see README) set http://localhost:3001 instead.
NVM_API_BASE_URL=https://api.sandbox.nevermined.app

# Origin of the Nevermined HOSTED checkout the chat embeds in an iframe. The
# browser also uses this exact value to verify event.origin on the success
# postMessage, so it must match the embed app's real origin. Local stack: http://localhost:4250
NVM_EMBED_BASE_URL=https://embed.nevermined.app
